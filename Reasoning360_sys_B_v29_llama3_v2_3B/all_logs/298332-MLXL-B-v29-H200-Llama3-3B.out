."], "solution": {"header": ["House", "Name", "Birthday"], "rows": [["1", "Arnold", "jan"], ["2", "Eric", "sept"], ["3", "Peter", "mar"], ["4", "Carol", "april"], ["5", "Bob", "feb"], ["6", "Alice", "may"]]}}
