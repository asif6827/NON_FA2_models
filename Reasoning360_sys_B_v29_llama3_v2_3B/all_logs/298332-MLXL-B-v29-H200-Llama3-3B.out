ol == 4.", "With all clues satisfied, the solution is clear."], "solution": {"header": ["House", "Name", "Height"], "rows": [["1", "Peter", "average"], ["2", "Carol", "super_tall"], ["3", "Bob", "tall"], ["4", "Arnold", "short"], ["5", "Eric", "very_tall"], ["6", "Alice", "very_short"]]}}
