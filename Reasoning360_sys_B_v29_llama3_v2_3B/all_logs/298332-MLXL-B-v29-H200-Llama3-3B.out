], "solution": {"header": ["House", "Name", "Height"], "rows": [["1", "Bob", "average"], ["2", "Carol", "super_tall"], ["3", "Alice", "tall"], ["4", "Peter", "short"], ["5", "Eric", "very_tall"], ["6", "Arnold", "very_short"]]}}
