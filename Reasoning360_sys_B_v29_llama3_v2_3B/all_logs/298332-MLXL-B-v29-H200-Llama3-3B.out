se.", "S10: Carol == 5.", "With all clues satisfied, the solution is clear."], "solution": {"header": ["House", "Name", "Height"], "rows": [["1", "Bob", "average"], ["2", "Eric", "very_tall"], ["3", "Alice", "tall"], ["4", "Carol", "short"], ["5", "Arnold", "super_tall"], ["6", "Peter", "very_short"]]}}
