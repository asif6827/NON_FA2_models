": {"header": ["House", "Name", "Birthday"], "rows": [["1", "Arnold", "jan"], ["2", "Eric", "april"], ["3", "Peter", "mar"], ["4", "Carol", "sept"], ["5", "Bob", "feb"], ["6", "Alice", "may"]]}}
