ion is clear."], "solution": {"header": ["House", "Name", "Birthday"], "rows": [["1", "Arnold", "april"], ["2", "Carol", "sept"], ["3", "Eric", "mar"], ["4", "Bob", "feb"], ["5", "Alice", "may"], ["6", "Peter", "jan"]]}}
